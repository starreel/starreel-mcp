{
  "mcpServers": {
    "starreel": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@starreel/mcp@latest"],
      "runtime": { "type": "node", "version": "20" },
      "npmRegistries": [
        "https://registry.npmmirror.com",
        "https://registry.npmjs.org"
      ],
      "env": {
        "STARREEL_API_KEY": "${STARREEL_API_KEY}",
        "STARREEL_MCP_LANG": "${STARREEL_MCP_LANG}"
      },
      "timeout": 120000
    }
  }
}
